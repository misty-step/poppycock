# Run pnpm install, then pnpm bootstrap, then pnpm dev.
# Bootstrap creates .env.local with independent random 32-byte signing secrets.
# Do not put cloud credentials or a production CONVEX_DEPLOYMENT in this checkout.
CONVEX_AGENT_MODE=anonymous
CONVEX_DEPLOYMENT=anonymous:anonymous-agent
POPPYCOCK_LOCAL=true

# Web: http://localhost:3210. Local Convex backend / site ports: 3220 / 3221.
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3220
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3221
# For physical phones on your LAN, change the two browser URLs in .env.local
# to this computer's LAN IP, preserving ports; restart pnpm dev afterwards.
# Local maintenance always connects to 127.0.0.1 regardless of browser URLs.

# These are SERVER-ONLY. Leave blank here; pnpm bootstrap fills .env.local.
# JSON format: {"local":"<base64url secret>"}, or for rotation:
# {"activeKeyId":"current","keys":{"current":"<secret>","old":"<secret>"}}
# Every secret must decode to at least 32 bytes. No NEXT_PUBLIC_ secret names.
PARLOR_GUEST_TOKEN_KEYS=
PARLOR_GUEST_TOKEN_AUDIENCE=poppycock
POPPYCOCK_CONTINUITY_SECRET=

# Access credentials expire after 15 minutes. The distinct signed HttpOnly
# identity cookie lasts 30 days, is SameSite=Lax, and is Secure in production.
# Losing or changing the continuity secret invalidates existing identities.
# Keep both issuer and Convex signing-key maps/audiences in sync on deployment.
# Production must never set POPPYCOCK_LOCAL=true; the reset action is internal
# and checks that flag as well as the CLI's anonymous-local deployment guard.
