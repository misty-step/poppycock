{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poppycock-backend-preview",
  "account_id": "b069014f6a46558ea9146fb6c4ff8f6c",
  "main": ".open-next/backend-bundle/worker.js",
  "no_bundle": true,
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "poppycock-backend-preview.mistystep.io", "custom_domain": true }],
  "send_metrics": false,
  "observability": { "enabled": true },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "POPPYCOCK_BACKEND", "class_name": "PoppycockBackend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PoppycockBackend"] }],
  "vars": { "PARLOR_GUEST_TOKEN_AUDIENCE": "poppycock", "SENTRY_ENVIRONMENT": "preview" }
}
